{
  "name": "gurapaws",
  "version": "0.1.0",
  "private": true,
  "description": "GuraPaws — a digital-native dog adoption platform for Hyderabad.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run db:reset && npm run db:export",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:check": "tsx src/db/check.ts",
    "db:export": "tsx src/db/export-catalog.ts",
    "db:reset": "tsx src/db/migrate.ts && tsx src/db/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.1",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.19",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "22.13.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.19",
    "eslint-config-prettier": "10.0.1",
    "prettier": "3.4.2",
    "tailwindcss": "4.3.0",
    "tsx": "^4.22.4",
    "typescript": "5.7.3"
  }
}
