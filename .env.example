# GuraPaws environment.
#
# Local dev needs NOTHING here — the app uses an embedded PGlite database
# written to ./.pglite (see src/db/index.ts). Just run:
#   npm run db:migrate && npm run db:seed && npm run db:check
#
# In production we point at a managed Postgres (Neon / Vercel Postgres /
# Supabase). When the server-hosting ticket lands, set DATABASE_URL and switch
# src/db/index.ts to the node-postgres driver — same schema, same migrations.
#
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gurapaws?sslmode=require"

# Optional: override the local PGlite data dir.
# PGLITE_DATA_DIR=".pglite"
